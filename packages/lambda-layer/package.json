{
  "name": "@trace-stack/lambda-layer",
  "version": "1.0.0",
  "private": true,
  "description": "Special handler for auto-wrapping tracer.",
  "main": "index.js",
  "scripts": {
    "test": "yarn build && jest",
    "replace-agent": "rm node_modules/@lumigo/tracer/dist/httpSpansAgent.js && cp lib/utils/httpSpansAgent.js node_modules/@lumigo/tracer/dist/httpSpansAgent.js",
    "build": "yarn replace-agent && esbuild index.js --bundle --platform=node --minify --target=node16 --outfile=artifact/nodejs/dist/auto_tracer_wrapper.js"
  },
  "files": [
    "nodejs/dist/index.js"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "esbuild": "^0.25.1",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.777.0",
    "@lumigo/tracer": "^1.107.1",
    "axios": "^1.8.4",
    "node-fetch": "^3.3.2"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
